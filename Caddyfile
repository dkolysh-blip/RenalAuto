# HTTPS-прокси: сертификат Let's Encrypt выпускается автоматически.
# Домен и порты задаются в .env: DOMAIN, HTTP_PORT, HTTPS_PORT.
# Если на сервере 443 занят (например, нодой Marzban/Xray), укажите HTTPS_PORT=8443 —
# сертификат всё равно выдаётся через порт 80, он должен быть свободен.
{
	http_port {$HTTP_PORT:80}
	https_port {$HTTPS_PORT:443}
}

{$DOMAIN:renal-auto.asia}, www.{$DOMAIN:renal-auto.asia} {
	# Проверку TLS-ALPN Let's Encrypt делает только на порт 443, а он может быть занят
	# (нода Marzban/Xray) — оставляем только HTTP-01 через порт 80.
	tls {
		issuer acme {
			disable_tlsalpn_challenge
		}
	}
	encode gzip
	reverse_proxy renalauto:8000 {
		# поток /api/stream (SSE) отдаём без буферизации
		flush_interval -1
	}
}
