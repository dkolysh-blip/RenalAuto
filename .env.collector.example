# Адрес вашего сайта и токен приёма (тот же, что INGEST_TOKEN в .env сервера)
COLLECTOR_SERVER=https://renal-auto.asia:8443
INGEST_TOKEN=
# Имя сборщика — видно в /health
COLLECTOR_NAME=seoul-1
COLLECTOR_SOURCES=encar
# Опрос раз в 2 минуты, пауза 2 с между карточками — бережно для площадки
POLL_INTERVAL=120
POLL_LIMIT=50
COLLECTOR_DETAIL_DELAY=2
# Страховая история Encar (ДТП, владельцы, тотал) — +1 запрос на новое объявление
COLLECTOR_HISTORY=true
# Если сборщик запущен не в Корее — корейский прокси вне дата-центра
PROXY_KR=
