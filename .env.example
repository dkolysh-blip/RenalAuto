# Домен сайта (A-записи домена должны указывать на IP сервера)
DOMAIN=renal-auto.asia
# Порты Caddy. Если 443 занят другим сервисом (нода Marzban/Xray) — HTTPS_PORT=8443
HTTP_PORT=80
HTTPS_PORT=443

# Площадки через запятую: kbchachacha, encar (Корея), dongchedi (Китай)
SOURCES=kbchachacha,encar,dongchedi
# Encar: web — через страницы сайта (работает с сервера в дата-центре), api — api.encar.com (нужен корейский IP)
ENCAR_MODE=web
POLL_INTERVAL=60
POLL_LIMIT=50
ENRICH_DETAILS=true
ENRICH_CONCURRENCY=3
ENRICH_PER_POLL=60
DB_PATH=/data/renalauto.db

# Прокси (рекомендуется корейский/китайский IP; http://user:pass@host:port или socks5://...)
PROXY_KR=
PROXY_CN=

# Курсы для пересчёта в USD
RATE_KRW_USD=0.00072
RATE_CNY_USD=0.14

# Бесплатный декодер NHTSA vPIC как доп. источник по VIN
VIN_NHTSA=true

# --- Сайт ---
COMPANY_NAME=Renal Auto
COMPANY_PHONE=8-800-250-57-78
COMPANY_EMAIL=ren125primorye@gmail.com
# Реквизиты в подвале сайта
COMPANY_LEGAL_NAME=ООО «ГАРАНТ-ЛОГИСТИКА»
COMPANY_REQUISITES=ИНН 2543160025 / КПП 254001001 · ОГРН 1212500021271
COMPANY_ADDRESS=690078, Приморский край, г. Владивосток, ул. Мыс Чумака, д. 1а, помещ. 408
# Мессенджер MAX компании для кнопок на сайте: ссылка на профиль или канал, например https://max.ru/renalauto
COMPANY_MAX=https://max.ru/channel_renalauto
# Яндекс Метрика: номер счётчика (цели: car_click, car_want, form_open, lead, telegram)
YM_ID=113699503
# Соцсети в подвале и в блоке «Выдачи клиентам»
COMPANY_VK=https://vk.ru/renal_auto
COMPANY_2GIS=https://2gis.ru/vladivostok/geo/70000001101310074
# рейтинг и число отзывов в 2ГИС — для блока отзывов, например 4.9 и 37
COMPANY_2GIS_RATING=
COMPANY_2GIS_REVIEWS=
# Условия агентского договора для лендинга /port: вознаграждение, обеспечительный платёж за бронь,
# срок подбора (иначе возврат предоплаты), срок оплаты инвойса, срок доставки до Владивостока
DEAL_FEE_RUB=50000
DEAL_DEPOSIT_RUB=120000
DEAL_PICK_DAYS=20
DEAL_INVOICE_DAYS=10
DEAL_DELIVERY_WEEKS=8
# Калькулятор под ключ: доставка до Владивостока из Кореи / Китая и оформление (СБКТС, ЭПТС, брокер), ₽.
# Пусто — в расчёте «назовёт менеджер»
DEAL_LOGISTICS_KR_RUB=
DEAL_LOGISTICS_CN_RUB=
DEAL_PAPERS_RUB=
SITE_URL=https://renal-auto.asia:8443
# Пароль для /admin (заявки) и служебных API. Обязательно задайте длинную случайную строку!
ADMIN_TOKEN=

# Курсы: берутся с ЦБ (RATES_LIVE=true); ниже — запасные значения, ₽ за 1 единицу
RATES_LIVE=true
RATE_KRW_RUB=0.058
RATE_CNY_RUB=11.2
RATE_USD_RUB=80
RATE_EUR_RUB=93

# --- Сборщики (Encar с корейского IP) ---
# Токен, с которым сборщики отправляют данные на /api/ingest. Пусто — приём выключен
INGEST_TOKEN=

# --- Telegram ---
# Бот: создать у @BotFather, токен сюда. Заявки с сайта уходят в TELEGRAM_MANAGER_CHAT_ID
# (id чата менеджеров; если пусто — в TELEGRAM_CHAT_ID)
TELEGRAM_MANAGER_CHAT_ID=
# Уведомления о новых объявлениях по сохранённым фильтрам
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Тонкая настройка площадок
# ENCAR_QUERIES=(And.Hidden.N._.CarType.Y.);(And.Hidden.N._.CarType.N.)
# DONGCHEDI_CITY=全国
# DONGCHEDI_SORT_TYPE=4
