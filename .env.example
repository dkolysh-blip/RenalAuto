# Домен сайта (A-записи домена должны указывать на IP сервера)
DOMAIN=renal-auto.asia
# Порты Caddy. Если 443 занят другим сервисом (нода Marzban/Xray) — HTTPS_PORT=8443
HTTP_PORT=80
HTTPS_PORT=443

# Площадки через запятую: kbchachacha, encar (Корея), dongchedi (Китай)
# encar блокирует IP облачных серверов (AWS и др.) — включайте, только если сервер вне дата-центра
SOURCES=kbchachacha,dongchedi
POLL_INTERVAL=60
POLL_LIMIT=50
ENRICH_DETAILS=true
ENRICH_CONCURRENCY=3
ENRICH_PER_POLL=60
DB_PATH=/data/renalauto.db

# Прокси (рекомендуется корейский/китайский IP; http://user:pass@host:port или socks5://...)
PROXY_KR=
PROXY_CN=

# Курсы для пересчёта в USD
RATE_KRW_USD=0.00072
RATE_CNY_USD=0.14

# Бесплатный декодер NHTSA vPIC как доп. источник по VIN
VIN_NHTSA=true

# --- Сайт ---
COMPANY_NAME=Renal Auto
COMPANY_PHONE=
# Telegram компании для кнопки в шапке, например @renalauto
COMPANY_TELEGRAM=
SITE_URL=https://renal-auto.asia:8443
# Пароль для /admin (заявки) и служебных API. Обязательно задайте длинную случайную строку!
ADMIN_TOKEN=

# Курсы: берутся с ЦБ (RATES_LIVE=true); ниже — запасные значения, ₽ за 1 единицу
RATES_LIVE=true
RATE_KRW_RUB=0.058
RATE_CNY_RUB=11.2
RATE_USD_RUB=80
RATE_EUR_RUB=93

# --- Сборщики (Encar с корейского IP) ---
# Токен, с которым сборщики отправляют данные на /api/ingest. Пусто — приём выключен
INGEST_TOKEN=

# --- Telegram ---
# Бот: создать у @BotFather, токен сюда. Заявки с сайта уходят в TELEGRAM_MANAGER_CHAT_ID
# (id чата менеджеров; если пусто — в TELEGRAM_CHAT_ID)
TELEGRAM_MANAGER_CHAT_ID=
# Уведомления о новых объявлениях по сохранённым фильтрам
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Тонкая настройка площадок
# ENCAR_QUERIES=(And.Hidden.N._.CarType.Y.);(And.Hidden.N._.CarType.N.)
# DONGCHEDI_CITY=全国
# DONGCHEDI_SORT_TYPE=4
